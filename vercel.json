{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "docs",
  "functions": {
    "api/chat.js": {
      "maxDuration": 60,
      "includeFiles": "docs/conversation-design.md"
    },
    "api/line-webhook.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/ffmpeg-static/ffmpeg"
    },
    "api/status.js": {
      "maxDuration": 60
    },
    "api/twilio/voice.js": {
      "maxDuration": 60,
      "includeFiles": "docs/conversation-design.md"
    },
    "api/twilio/call.js": {
      "maxDuration": 60
    }
  }
}
