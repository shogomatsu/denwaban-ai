# このファイルは見本です。コピーして「.env」という名前にし、値を入れて使います。
# .env は .gitignore に入っているので、GitHub にはアップロードされません。
# Vercel では、同じ名前・同じ値を「Environment Variables」に登録します。

# ---- 必須 ----
# Claude Console で発行した API キー（sk-ant- で始まる文字）
ANTHROPIC_API_KEY=
# 画面で入力してもらう合言葉（ひらがな・漢字も使えます。全角/半角のちがいは気にしません）
ACCESS_PASSCODE=

# ---- AI の種類（空なら claude-haiku-5-5）----
# 速さを比べるときは claude-sonnet-5-5 に変える
AI_MODEL=
# 考える深さ：low / medium / high（空なら low。低いほど速い）
AI_EFFORT=
# 調整係（通話のあとに協力者を選ぶ）のモデル。空なら claude-sonnet-5-5
COORDINATOR_MODEL=

# ---- 人物の設定（空なら lib/profile.js の架空のデモ用の値）----
# 実際のご家族の名前は、ここ（と Vercel）にだけ入れて、コードには書かない
AI_NAME=
USER_NAME=
FAMILY_NAME=
# 本人の住んでいる地区（例：国見町）。住所は入れない
USER_AREA=
# 引き受けた協力者1人にだけ伝える、本人の住所と電話番号（空ならデモ用の架空の値）
USER_ADDRESS=
USER_PHONE=
USER_NOTES=
WEATHER=

# ---- データベース（Supabase。空なら保存しない）----
# Project Settings → API Keys の「Project URL」
SUPABASE_URL=
# 同じ画面の Secret keys（sb_secret_ で始まる）。絶対に公開しない
SUPABASE_SECRET_KEY=

# ---- ご家族への LINE 通知（空なら送らず、画面に表示だけ）----
# LINE Developers の Messaging API 設定で発行する「チャネルアクセストークン（長期）」
LINE_CHANNEL_ACCESS_TOKEN=
# 送り先のユーザーID（U で始まる文字、カンマ区切り）。空なら公式アカウントの友だち全員に送る
LINE_TO_USER_IDS=
# LINE Developers の「チャネル基本設定」のチャネルシークレット（「引き受ける」ボタンの受け口で使う）
LINE_CHANNEL_SECRET=

# ---- 電話（Twilio。空なら電話は使わない）----
# Twilio の Console の Account Info にある Account SID（AC で始まる）
TWILIO_ACCOUNT_SID=
# 同じ場所の Auth Token（秘密。絶対に公開しない）
TWILIO_AUTH_TOKEN=
# 買ったアメリカの番号（+1 で始まる。例：+15551234567）
TWILIO_PHONE_NUMBER=
# ゆげ丸が電話をかける相手（本人の電話。+81 で始まる。例：+819012345678）
TWILIO_CALL_TO=
# かかってきた電話を受けてよい番号（カンマ区切り。空なら TWILIO_CALL_TO だけ）
TWILIO_ALLOWED_NUMBERS=
# 読み上げの声（空なら Polly.Kazuha-Neural。ほかに Polly.Tomoko-Neural、Polly.Takumi-Neural など）
TWILIO_VOICE=
# 公開アドレス（例：https://denwaban-ai.vercel.app）。Twilio の署名の確認に使う
PUBLIC_BASE_URL=

# ---- GitHub Pages 版の画面からも呼ぶとき（空なら https://shogomatsu.github.io）----
ALLOWED_ORIGINS=
