# このファイルは見本です。コピーして「.env」という名前にし、値を入れて使います。
# .env は .gitignore に入っているので、GitHub にはアップロードされません。
# Vercel では、同じ名前・同じ値を「Environment Variables」に登録します。

# ---- 必須 ----
# Claude Console で発行した API キー（sk-ant- で始まる文字）
ANTHROPIC_API_KEY=
# 画面で入力してもらう合言葉（ひらがな・漢字も使えます。全角/半角のちがいは気にしません）
ACCESS_PASSCODE=

# ---- AI の種類（空なら claude-haiku-5-5）----
# 速さを比べるときは claude-sonnet-5-5 に変える
AI_MODEL=
# 考える深さ：low / medium / high（空なら low。低いほど速い）
AI_EFFORT=

# ---- 人物の設定（空なら lib/profile.js の架空のデモ用の値）----
# 実際のご家族の名前は、ここ（と Vercel）にだけ入れて、コードには書かない
AI_NAME=
USER_NAME=
FAMILY_NAME=
USER_NOTES=
WEATHER=

# ---- GitHub Pages 版の画面からも呼ぶとき（空なら https://shogomatsu.github.io）----
ALLOWED_ORIGINS=
